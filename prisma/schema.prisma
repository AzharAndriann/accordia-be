generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  FREELANCER
  CLIENT
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  name            String
  role            UserRole
  passwordHash    String
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  sessions        Session[]
  createdProjects Project[]       @relation("ProjectCreator")
  projectMembers  ProjectMember[]
  sentInvitations Invitation[]    @relation("InvitationInviter")
  createdAgreementVersions AgreementVersion[]  @relation("AgreementCreator")
  rejectedAgreementVersions AgreementVersion[] @relation("AgreementRejector")
  agreementApprovals       AgreementApproval[]
  changeRequests           ChangeRequest[] @relation("ChangeRequester")
  uploadedFiles            File[] @relation("FileUploader")
  submittedDeliveries      Delivery[] @relation("DeliverySubmitter")
  requestedRevisions       RevisionRequest[] @relation("RevisionRequester")
  submittedPayments        Payment[] @relation("PaymentSubmitter")
  reviewedPayments         Payment[] @relation("PaymentReviewer")
  auditEvents              AuditEvent[] @relation("AuditActor")
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  DELIVERED
  COMPLETED
  CANCELLED
}

enum ProjectRole {
  FREELANCER
  CLIENT
}

model Project {
  id                       String          @id @default(uuid()) @db.Uuid
  title                    String          @db.VarChar(160)
  description              String          @db.Text
  creatorId                String          @db.Uuid
  status                   ProjectStatus   @default(DRAFT)
  activeAgreementVersionId String?         @unique @db.Uuid
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  creator                  User            @relation("ProjectCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  members                  ProjectMember[]
  invitations              Invitation[]
  agreementVersions        AgreementVersion[] @relation("ProjectAgreementVersions")
  activeAgreementVersion   AgreementVersion?  @relation("ActiveAgreementVersion", fields: [activeAgreementVersionId], references: [id], onDelete: SetNull)
  changeRequests           ChangeRequest[]
  files                    File[]
  deliveries               Delivery[]
  payments                 Payment[]
  auditEvents              AuditEvent[]

  @@index([creatorId])
  @@index([createdAt, id])
}

model ProjectMember {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @db.Uuid
  userId    String      @db.Uuid
  role      ProjectRole
  createdAt DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([projectId, userId])
  @@unique([projectId, role])
  @@index([userId])
}

model Invitation {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @db.Uuid
  targetEmail String    @db.VarChar(254)
  tokenHash   String    @unique @db.Char(64)
  expiresAt   DateTime
  acceptedAt  DateTime?
  inviterId   String    @db.Uuid
  createdAt   DateTime  @default(now())
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inviter     User      @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Restrict)

  @@index([projectId, targetEmail])
  @@index([expiresAt])
}

enum AgreementStatus {
  DRAFT
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model AgreementVersion {
  id                       String              @id @default(uuid()) @db.Uuid
  projectId                String              @db.Uuid
  versionNumber            Int
  status                   AgreementStatus     @default(DRAFT)
  scope                    String              @db.Text
  deliverables             String[]
  amountRupiah             Decimal             @db.Decimal(18, 0)
  deadline                 DateTime            @db.Date
  revisionLimit            Int
  cancellationTerms        String              @db.Text
  ipTerms                  String              @db.Text
  contentHash              String              @db.Char(64)
  baseAgreementVersionId   String?             @db.Uuid
  createdById              String              @db.Uuid
  rejectedById             String?             @db.Uuid
  rejectionReason          String?             @db.Text
  reviewedAt               DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  project                  Project             @relation("ProjectAgreementVersions", fields: [projectId], references: [id], onDelete: Cascade)
  activeForProjects        Project[]           @relation("ActiveAgreementVersion")
  createdBy                User                @relation("AgreementCreator", fields: [createdById], references: [id], onDelete: Restrict)
  rejectedBy               User?               @relation("AgreementRejector", fields: [rejectedById], references: [id], onDelete: Restrict)
  approvals                AgreementApproval[]
  proposedForChange        ChangeRequest?      @relation("ProposedAgreementVersion")
  deliveries               Delivery[]

  @@unique([projectId, versionNumber])
  @@index([projectId, status])
  @@index([createdById])
}

enum ChangeRequestStatus {
  REQUESTED
  PROPOSED
  ACCEPTED
  REJECTED
}

model ChangeRequest {
  id                     String              @id @default(uuid()) @db.Uuid
  projectId              String              @db.Uuid
  requestedById          String              @db.Uuid
  reason                 String              @db.Text
  baseAgreementVersionId String              @db.Uuid
  proposedVersionId      String?             @unique @db.Uuid
  status                 ChangeRequestStatus @default(REQUESTED)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  project                Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy            User                @relation("ChangeRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  proposedVersion        AgreementVersion?   @relation("ProposedAgreementVersion", fields: [proposedVersionId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt, id])
  @@index([requestedById])
}

enum FileStatus {
  READY
  FAILED
}

model File {
  id           String     @id @default(uuid()) @db.Uuid
  projectId    String     @db.Uuid
  uploaderId   String     @db.Uuid
  storageKey   String     @unique @db.VarChar(100)
  originalName String     @db.VarChar(255)
  mimeType     String     @db.VarChar(50)
  size         Int
  checksum     String     @db.Char(64)
  status       FileStatus @default(READY)
  createdAt    DateTime   @default(now())
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader     User       @relation("FileUploader", fields: [uploaderId], references: [id], onDelete: Restrict)
  deliveryFile DeliveryFile?
  paymentFile  PaymentFile?

  @@index([projectId, createdAt])
  @@index([uploaderId])
}

enum DeliveryStatus {
  PENDING
  REVISION_REQUESTED
  ACCEPTED
}

model Delivery {
  id                 String         @id @default(uuid()) @db.Uuid
  projectId          String         @db.Uuid
  agreementVersionId String         @db.Uuid
  submittedById      String         @db.Uuid
  note               String         @db.Text
  links              String[]
  status             DeliveryStatus @default(PENDING)
  submittedAt        DateTime       @default(now())
  reviewedAt         DateTime?
  project            Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agreementVersion   AgreementVersion @relation(fields: [agreementVersionId], references: [id], onDelete: Restrict)
  submittedBy        User           @relation("DeliverySubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  files              DeliveryFile[]
  revisionRequest    RevisionRequest?

  @@index([projectId, submittedAt, id])
  @@index([agreementVersionId])
  @@index([submittedById])
}

model DeliveryFile {
  deliveryId String   @db.Uuid
  fileId     String   @unique @db.Uuid
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  file       File     @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@id([deliveryId, fileId])
}

model RevisionRequest {
  id            String   @id @default(uuid()) @db.Uuid
  deliveryId    String   @unique @db.Uuid
  requestedById String   @db.Uuid
  reason        String   @db.Text
  roundNumber   Int
  createdAt     DateTime @default(now())
  delivery      Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  requestedBy   User     @relation("RevisionRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([requestedById])
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  projectId       String        @db.Uuid
  amountRupiah    Decimal       @db.Decimal(18, 0)
  submittedById   String        @db.Uuid
  status          PaymentStatus @default(PENDING)
  reviewedById    String?       @db.Uuid
  note            String        @db.Text
  rejectionReason String?       @db.Text
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedBy     User          @relation("PaymentSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy      User?         @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  files           PaymentFile[]

  @@index([projectId, createdAt, id])
  @@index([submittedById])
  @@index([reviewedById])
}

model PaymentFile {
  paymentId String  @db.Uuid
  fileId    String  @unique @db.Uuid
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  file      File    @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@id([paymentId, fileId])
}

enum AuditEventType {
  PROJECT_CREATED
  INVITATION_CREATED
  INVITATION_ACCEPTED
  AGREEMENT_DRAFT_CREATED
  AGREEMENT_UPDATED
  AGREEMENT_SUBMITTED
  AGREEMENT_APPROVED
  AGREEMENT_ACCEPTED
  AGREEMENT_REJECTED
  CHANGE_REQUEST_CREATED
  CHANGE_REQUEST_PROPOSED
  FILE_UPLOADED
  DELIVERY_SUBMITTED
  DELIVERY_ACCEPTED
  REVISION_REQUESTED
  PAYMENT_SUBMITTED
  PAYMENT_CONFIRMED
  PAYMENT_REJECTED
}

model AuditEvent {
  id         String         @id @default(uuid()) @db.Uuid
  projectId  String         @db.Uuid
  actorId    String         @db.Uuid
  type       AuditEventType
  entityType String         @db.VarChar(40)
  entityId   String         @db.Uuid
  metadata   Json           @default("{}")
  serverTime DateTime       @default(now())
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor      User           @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([projectId, serverTime, id])
  @@index([actorId])
}

model AgreementApproval {
  id         String           @id @default(uuid()) @db.Uuid
  versionId  String           @db.Uuid
  userId     String           @db.Uuid
  approvedAt DateTime         @default(now())
  version    AgreementVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([versionId, userId])
  @@index([userId])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique @db.Char(64)
  tokenFamilyId    String    @db.Uuid
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([tokenFamilyId])
}
